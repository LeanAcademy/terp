                <Tab text="Genel">
                    <content>
                        <GridPane hgap="10.0" vgap="8.0">
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints prefWidth="130.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                                <ColumnConstraints prefWidth="130.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label text="Uzun tanım" />
                                <TextField fx:id="txtLongDesc" GridPane.columnIndex="1" GridPane.columnSpan="3" />
                                <Label text="Tür" GridPane.rowIndex="1" />
                                <ComboBox fx:id="cmbItemType" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Grup" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="txtItemGroup" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                <Label text="Sınıf" GridPane.rowIndex="2" />
                                <TextField fx:id="txtItemClass" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label text="Marka" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                <TextField fx:id="txtBrand" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                <Label text="Barkod" GridPane.rowIndex="3" />
                                <TextField fx:id="txtBarcode" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label text="GTIN" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                <TextField fx:id="txtGtin" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                                <Label text="Menşei" GridPane.rowIndex="4" />
                                <TextField fx:id="txtOriginCountry" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <Label text="Notlar" GridPane.rowIndex="5" />
                                <TextArea fx:id="txtNotes" prefHeight="90.0" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5" />
                            </children>
                        </GridPane>
                    </content>
                </Tab>
                <Tab text="Tedarikçi kodları">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>
                            <children>
                                <GridPane hgap="8.0" vgap="6.0">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="70.0" />
                                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200.0" />
                                        <ColumnConstraints prefWidth="90.0" />
                                        <ColumnConstraints prefWidth="140.0" />
                                        <ColumnConstraints prefWidth="90.0" />
                                        <ColumnConstraints hgrow="ALWAYS" prefWidth="180.0" />
                                        <ColumnConstraints prefWidth="80.0" />
                                        <ColumnConstraints prefWidth="80.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Cari" />
                                        <ComboBox fx:id="cmbSupplierAccount" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" />
                                        <Label text="Stok kodu" GridPane.columnIndex="2" />
                                        <TextField fx:id="txtSupplierItemCode" GridPane.columnIndex="3" />
                                        <Label text="Stok adı" GridPane.columnIndex="4" />
                                        <TextField fx:id="txtSupplierItemName" GridPane.columnIndex="5" />
                                        <Button fx:id="btnAddSupplierCode" mnemonicParsing="false" onAction="#onActionAddSupplierCode" text="Ekle" GridPane.columnIndex="6" />
                                        <Button fx:id="btnRemoveSupplierCode" mnemonicParsing="false" onAction="#onActionRemoveSupplierCode" text="Sil" GridPane.columnIndex="7" />
                                    </children>
                                </GridPane>
                                <TableView fx:id="tblSupplierCodes" prefHeight="320.0" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="tcSupplierAccountCode" prefWidth="120.0" text="Cari kodu" />
                                        <TableColumn fx:id="tcSupplierAccountName" prefWidth="200.0" text="Cari unvan" />
                                        <TableColumn fx:id="tcSupplierItemCode" prefWidth="140.0" text="Tedarikçi stok kodu" />
                                        <TableColumn fx:id="tcSupplierItemName" prefWidth="240.0" text="Tedarikçi stok adı" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Müşteri kodları">
                    <content>
                        <VBox spacing="8.0">
