                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>
                            <children>
                                <GridPane hgap="8.0" vgap="6.0">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="70.0" />
                                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200.0" />
                                        <ColumnConstraints prefWidth="90.0" />
                                        <ColumnConstraints prefWidth="140.0" />
                                        <ColumnConstraints prefWidth="90.0" />
                                        <ColumnConstraints hgrow="ALWAYS" prefWidth="180.0" />
                                        <ColumnConstraints prefWidth="80.0" />
                                        <ColumnConstraints prefWidth="80.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Cari" />
                                        <ComboBox fx:id="cmbCustomerAccount" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" />
                                        <Label text="Stok kodu" GridPane.columnIndex="2" />
                                        <TextField fx:id="txtCustomerItemCode" GridPane.columnIndex="3" />
                                        <Label text="Stok adı" GridPane.columnIndex="4" />
                                        <TextField fx:id="txtCustomerItemName" GridPane.columnIndex="5" />
                                        <Button fx:id="btnAddCustomerCode" mnemonicParsing="false" onAction="#onActionAddCustomerCode" text="Ekle" GridPane.columnIndex="6" />
                                        <Button fx:id="btnRemoveCustomerCode" mnemonicParsing="false" onAction="#onActionRemoveCustomerCode" text="Sil" GridPane.columnIndex="7" />
                                    </children>
                                </GridPane>
                                <TableView fx:id="tblCustomerCodes" prefHeight="320.0" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="tcCustomerAccountCode" prefWidth="120.0" text="Cari kodu" />
                                        <TableColumn fx:id="tcCustomerAccountName" prefWidth="200.0" text="Cari unvan" />
                                        <TableColumn fx:id="tcCustomerItemCode" prefWidth="140.0" text="Müşteri stok kodu" />
                                        <TableColumn fx:id="tcCustomerItemName" prefWidth="240.0" text="Müşteri stok adı" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Ölçü">
