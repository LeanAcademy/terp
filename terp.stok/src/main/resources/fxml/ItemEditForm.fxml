                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label text="Ana birim" />
                                <TextField fx:id="txtItemUnit" GridPane.columnIndex="1" />
                                <Label text="İkinci birim" GridPane.columnIndex="2" />
                                <TextField fx:id="txtSecondUnit" GridPane.columnIndex="3" />
                                <Label text="Çevrim katsayısı" GridPane.rowIndex="1" />
                                <TextField fx:id="txtUnitFactor" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Ağırlık" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="txtWeight" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                <Label text="Hacim" GridPane.rowIndex="2" />
                                <TextField fx:id="txtVolume" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label text="En" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                <TextField fx:id="txtWidth" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                <Label text="Boy" GridPane.rowIndex="3" />
                                <TextField fx:id="txtLength" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label text="Yükseklik" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                <TextField fx:id="txtHeight" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                            </children>
                        </GridPane>
                    </content>
                </Tab>
                <Tab text="Stok">
                    <content>
                        <GridPane hgap="10.0" vgap="8.0">
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints prefWidth="140.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                                <ColumnConstraints prefWidth="140.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label text="Min. stok" />
                                <TextField fx:id="txtMinStock" GridPane.columnIndex="1" />
                                <Label text="Max. stok" GridPane.columnIndex="2" />
                                <TextField fx:id="txtMaxStock" GridPane.columnIndex="3" />
                                <Label text="Emniyet stoğu" GridPane.rowIndex="1" />
                                <TextField fx:id="txtSafetyStock" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Raf ömrü (gün)" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="txtShelfLifeDays" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                <CheckBox fx:id="chkLotTracked" mnemonicParsing="false" text="Lot takibi" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <CheckBox fx:id="chkSerialTracked" mnemonicParsing="false" text="Seri takibi" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>
                    </content>
                </Tab>
                <Tab text="Ticari">
                    <content>
                        <GridPane hgap="10.0" vgap="8.0">
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints prefWidth="140.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                                <ColumnConstraints prefWidth="140.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label text="KDV %" />
                                <TextField fx:id="txtVatRate" GridPane.columnIndex="1" />
                                <Label text="Para birimi" GridPane.columnIndex="2" />
                                <TextField fx:id="txtCurrency" GridPane.columnIndex="3" />
                                <Label text="Alış fiyatı" GridPane.rowIndex="1" />
                                <TextField fx:id="txtPurchasePrice" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Satış fiyatı" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="txtSalesPrice" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                    </content>
                </Tab>
                <Tab text="Muhasebe">
                    <content>
                        <GridPane hgap="10.0" vgap="8.0">
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints prefWidth="160.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label text="Stok hesabı" />
                                <TextField fx:id="txtStockAccount" GridPane.columnIndex="1" />
                                <Label text="Alış hesabı" GridPane.rowIndex="1" />
                                <TextField fx:id="txtPurchaseAccount" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Satış hesabı" GridPane.rowIndex="2" />
                                <TextField fx:id="txtSalesAccount" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
