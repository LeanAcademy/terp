<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="540.0" prefWidth="980.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.terp.stok.gui.StockStatusFormController">
    <stylesheets>
        <URL value="@../styles/itemform.css" />
    </stylesheets>
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <VBox BorderPane.alignment="CENTER">
                    <children>
                        <ToolBar prefHeight="40.0">
                            <items>
                                <Button fx:id="btnRefresh" defaultButton="true" mnemonicParsing="false" onAction="#onActionBtnRefresh" prefWidth="95.0" text="Yenile" />
                            </items>
                        </ToolBar>
                        <GridPane hgap="8.0" vgap="6.0">
                            <padding>
                                <Insets bottom="6.0" left="8.0" right="8.0" top="4.0" />
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints prefWidth="220.0" />
                                <ColumnConstraints hgrow="ALWAYS" prefWidth="180.0" />
                                <ColumnConstraints prefWidth="160.0" />
                                <ColumnConstraints prefWidth="140.0" />
                            </columnConstraints>
                            <children>
                                <ComboBox fx:id="cmbWarehouse" editable="true" maxWidth="Infinity" promptText="Depo" />
                                <TextField fx:id="txtItemCode" promptText="Malzeme kodu / tanım" GridPane.columnIndex="1" />
                                <CheckBox fx:id="chkOnlyNonZero" mnemonicParsing="false" selected="true" text="Sıfır hariç" GridPane.columnIndex="2" />
                                <CheckBox fx:id="chkOnlyBelowMin" mnemonicParsing="false" text="Min. altı" GridPane.columnIndex="3" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>
            </top>
            <center>
                <TableView fx:id="tblvStatusView" tableMenuButtonVisible="true" BorderPane.alignment="CENTER">
                    <columns>
                        <TableColumn fx:id="tcWarehouseCode" prefWidth="90.0" text="Depo" />
                        <TableColumn fx:id="tcWarehouseName" prefWidth="140.0" text="Depo adı" />
                        <TableColumn fx:id="tcItemCode" prefWidth="110.0" text="Malzeme" />
                        <TableColumn fx:id="tcItemDesc" prefWidth="220.0" text="Tanım" />
                        <TableColumn fx:id="tcItemUnit" prefWidth="60.0" text="Birim" />
                        <TableColumn fx:id="tcQuantity" prefWidth="90.0" text="Miktar" />
                        <TableColumn fx:id="tcMinStock" prefWidth="80.0" text="Min." />
                        <TableColumn fx:id="tcMaxStock" prefWidth="80.0" text="Max." />
                        <TableColumn fx:id="tcStatusLabel" prefWidth="90.0" text="Durum" />
                    </columns>
                </TableView>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
