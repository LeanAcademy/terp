<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="640.0" prefWidth="980.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.terp.stok.gui.CountEditFormController">
    <stylesheets>
        <URL value="@../styles/itemform.css" />
    </stylesheets>
    <children>
        <ToolBar prefHeight="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <Button fx:id="btnSave" mnemonicParsing="false" onAction="#onActionBtnSave" text="Taslak kaydet" />
                <Button fx:id="btnApprove" defaultButton="true" mnemonicParsing="false" onAction="#onActionBtnApprove" text="Onayla" />
                <Button fx:id="btnCancelPosted" mnemonicParsing="false" onAction="#onActionBtnCancelPosted" text="İptal" />
                <Button fx:id="btnClose" cancelButton="true" mnemonicParsing="false" onAction="#onActionBtnClose" text="Kapat" />
            </items>
        </ToolBar>
        <GridPane hgap="10.0" vgap="8.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="48.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Belge no" />
                <TextField fx:id="txtDocumentNo" promptText="Boş = otomatik" GridPane.columnIndex="1" />
                <Label text="Tarih" GridPane.columnIndex="2" />
                <DatePicker fx:id="dtDocumentDate" maxWidth="Infinity" GridPane.columnIndex="3" />
                <Label text="Depo" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbWarehouse" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Button fx:id="btnFillWarehouse" mnemonicParsing="false" onAction="#onActionBtnFillWarehouse" text="Depodan doldur" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Button fx:id="btnRefreshOnHand" mnemonicParsing="false" onAction="#onActionBtnRefreshOnHand" text="Eldeyi yenile" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <Label text="Notlar" GridPane.rowIndex="2" />
                <TextArea fx:id="txtNotes" prefHeight="50.0" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox spacing="8.0" alignment="CENTER_LEFT" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="190.0">
            <children>
                <ComboBox fx:id="cmbItem" editable="true" maxWidth="Infinity" prefWidth="260.0" promptText="Malzeme" />
                <TextField fx:id="txtCounted" prefWidth="90.0" promptText="Sayılan" />
                <TextField fx:id="txtUnit" prefWidth="70.0" promptText="Birim" />
                <Label fx:id="lblOnHand" prefWidth="140.0" text="" />
                <Button fx:id="btnAddLine" mnemonicParsing="false" onAction="#onActionBtnAddLine" text="Satır ekle" />
                <Button fx:id="btnRemoveLine" mnemonicParsing="false" onAction="#onActionBtnRemoveLine" text="Satır sil" />
            </children>
        </HBox>
        <Label wrapText="true" text="Onay, sayılan ile o anki eldeki farkını SAYIM_ART / SAYIM_AZ olarak basar. Sıfır bakiyeli malzeme satır ekle ile eklenir. Elle STK04 sayım satırı bu belgeye bağlanmaz." AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="228.0" />
        <TableView fx:id="tblvLines" editable="true" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="270.0">
            <columns>
                <TableColumn fx:id="tcLineNo" prefWidth="50.0" text="No" />
                <TableColumn fx:id="tcItemCode" prefWidth="110.0" text="Kod" />
                <TableColumn fx:id="tcItemDesc" prefWidth="240.0" text="Malzeme" />
                <TableColumn fx:id="tcItemUnit" prefWidth="70.0" text="Birim" />
                <TableColumn fx:id="tcOnHandQty" prefWidth="90.0" text="Eldeki" />
                <TableColumn fx:id="tcCountedQty" prefWidth="90.0" text="Sayılan" />
                <TableColumn fx:id="tcDifference" prefWidth="90.0" text="Fark" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
