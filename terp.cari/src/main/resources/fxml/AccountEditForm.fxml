<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="560.0" prefWidth="780.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.terp.cari.gui.AccountEditFormController">
    <stylesheets>
        <URL value="@../styles/accountform.css" />
    </stylesheets>
    <children>
        <ToolBar prefHeight="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <Button fx:id="btnSubmit" defaultButton="true" mnemonicParsing="false" onAction="#onActionBtnSubmit" text="Kaydet" />
                <Button fx:id="btnCancel" cancelButton="true" mnemonicParsing="false" onAction="#onActionBtnCancel" text="Vazgeç" />
            </items>
        </ToolBar>
        <GridPane hgap="10.0" vgap="8.0" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="48.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <padding>
                <Insets bottom="8.0" top="8.0" />
            </padding>
            <children>
                <Label text="Kod" />
                <TextField fx:id="txtAccountCode" GridPane.columnIndex="1" />
                <Label text="Unvan" GridPane.columnIndex="2" />
                <TextField fx:id="txtAccountName" GridPane.columnIndex="3" />
                <Label text="Uzun unvan" GridPane.rowIndex="1" />
                <TextField fx:id="txtLongName" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
                <CheckBox fx:id="chkCustomer" mnemonicParsing="false" selected="true" text="Müşteri" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <CheckBox fx:id="chkSupplier" mnemonicParsing="false" selected="true" text="Tedarikçi" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                <CheckBox fx:id="chkActive" mnemonicParsing="false" selected="true" text="Aktif" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Vergi no" GridPane.rowIndex="4" />
                <TextField fx:id="txtTaxId" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="Vergi dairesi" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                <TextField fx:id="txtTaxOffice" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                <Label text="Adres" GridPane.rowIndex="5" />
                <TextArea fx:id="txtAddress" prefHeight="70.0" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5" />
                <Label text="Ülke" GridPane.rowIndex="6" />
                <TextField fx:id="txtCountry" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                <Label text="Şehir" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                <TextField fx:id="txtCity" GridPane.columnIndex="3" GridPane.rowIndex="6" />
                <Label text="Telefon" GridPane.rowIndex="7" />
                <TextField fx:id="txtPhone" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                <Label text="E-posta" GridPane.columnIndex="2" GridPane.rowIndex="7" />
                <TextField fx:id="txtEmail" GridPane.columnIndex="3" GridPane.rowIndex="7" />
                <Label text="Notlar" GridPane.rowIndex="8" />
                <TextArea fx:id="txtNotes" prefHeight="80.0" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="8" />
            </children>
        </GridPane>
    </children>
</AnchorPane>
