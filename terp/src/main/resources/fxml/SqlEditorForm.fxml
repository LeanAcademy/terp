<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="520.0" prefWidth="860.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.terp.gui.controllers.SqlEditorFormController">
    <stylesheets>
        <URL value="@../styles/globalstyle.css" />
    </stylesheets>
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="6.0" left="8.0" right="8.0" top="8.0" />
                    </padding>
                    <children>
                        <Label text="SQL (yalnız sistem yöneticisi)" />
                        <TextArea fx:id="txtSql" prefHeight="120.0" wrapText="true" />
                        <HBox spacing="8.0">
                            <children>
                                <Button fx:id="btnRun" defaultButton="true" mnemonicParsing="false" onAction="#onActionBtnRun" text="Çalıştır" />
                                <Button fx:id="btnClose" cancelButton="true" mnemonicParsing="false" onAction="#onActionBtnClose" text="Kapat" />
                                <Label fx:id="lblStatus" text="" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>
            <center>
                <TableView fx:id="tblvResult" tableMenuButtonVisible="true">
                    <placeholder>
                        <Label text="Sonuç yok" />
                    </placeholder>
                </TableView>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
