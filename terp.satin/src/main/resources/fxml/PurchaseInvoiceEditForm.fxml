<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="1100.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.terp.satin.gui.PurchaseInvoiceEditFormController">
    <stylesheets>
        <URL value="@../styles/receiptform.css" />
    </stylesheets>
    <children>
        <ToolBar prefHeight="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <Button fx:id="btnSave" mnemonicParsing="false" onAction="#onActionBtnSave" text="Taslak kaydet" />
                <Button fx:id="btnApprove" defaultButton="true" mnemonicParsing="false" onAction="#onActionBtnApprove" text="Onayla" />
                <Button fx:id="btnCancelPosted" mnemonicParsing="false" onAction="#onActionBtnCancelPosted" text="İptal" />
                <Button fx:id="btnPrint" mnemonicParsing="false" onAction="#onActionBtnPrint" text="Yazdır" />
                <Button fx:id="btnClose" cancelButton="true" mnemonicParsing="false" onAction="#onActionBtnClose" text="Kapat" />
            </items>
        </ToolBar>
        <GridPane hgap="10.0" vgap="8.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="48.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Sistem no" />
                <TextField fx:id="txtDocumentNo" promptText="Boş = otomatik" GridPane.columnIndex="1" />
                <Label text="Tarih" GridPane.columnIndex="2" />
                <DatePicker fx:id="dtDocumentDate" maxWidth="Infinity" GridPane.columnIndex="3" />
                <Label text="Belge no" GridPane.rowIndex="1" />
                <TextField fx:id="txtOfficialNo" promptText="Fatura / evrak no" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Tedarikçi" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbAccount" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Depo" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbWarehouse" editable="true" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                <Label text="Mal kabulden yükle" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbSourceReceipt" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Button fx:id="btnLoadRemaining" mnemonicParsing="false" onAction="#onActionBtnLoadRemaining" text="Kalan satırları yükle" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="3" />
                <Label text="Notlar" GridPane.rowIndex="4" />
                <TextArea fx:id="txtNotes" prefHeight="50.0" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4" />
            </children>
        </GridPane>
        <HBox spacing="8.0" alignment="CENTER_LEFT" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="268.0">
            <children>
                <ComboBox fx:id="cmbReceipt" editable="true" prefWidth="180.0" promptText="Mal kabul no" />
                <ComboBox fx:id="cmbItem" editable="true" maxWidth="Infinity" prefWidth="220.0" promptText="Malzeme" />
                <TextField alignment="CENTER_RIGHT" fx:id="txtQuantity" prefWidth="80.0" promptText="Miktar" />
                <TextField fx:id="txtUnit" prefWidth="60.0" promptText="Birim" />
                <TextField alignment="CENTER_RIGHT" fx:id="txtUnitPrice" prefWidth="80.0" promptText="Fiyat" />
                <ComboBox fx:id="cmbVatRate" prefWidth="160.0" promptText="KDV" />
                <Label fx:id="lblRemaining" prefWidth="110.0" text="" />
                <Button fx:id="btnAddLine" mnemonicParsing="false" onAction="#onActionBtnAddLine" text="Satır ekle" />
                <Button fx:id="btnRemoveLine" mnemonicParsing="false" onAction="#onActionBtnRemoveLine" text="Satır sil" />
            </children>
        </HBox>
        <TableView fx:id="tblvLines" editable="true" AnchorPane.bottomAnchor="44.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="308.0">
            <columns>
                <TableColumn fx:id="tcSourceReceiptNo" prefWidth="100.0" text="Mal kabul" />
                <TableColumn fx:id="tcItemCode" prefWidth="90.0" text="Kod" />
                <TableColumn fx:id="tcItemDesc" prefWidth="180.0" text="Malzeme" />
                <TableColumn fx:id="tcItemUnit" prefWidth="55.0" text="Birim" />
                <TableColumn fx:id="tcQuantity" prefWidth="80.0" text="Miktar" />
                <TableColumn fx:id="tcUnitPrice" prefWidth="75.0" text="Fiyat" />
                <TableColumn fx:id="tcVatRate" prefWidth="65.0" text="KDV %" />
                <TableColumn fx:id="tcNetAmount" prefWidth="85.0" text="Tutar" />
                <TableColumn fx:id="tcVatAmount" prefWidth="75.0" text="KDV" />
                <TableColumn fx:id="tcGrossAmount" prefWidth="90.0" text="Toplam" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="24.0" AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0">
            <children>
                <Label fx:id="lblNetTotal" text="Ara toplam: 0,00" />
                <Label fx:id="lblVatTotal" text="KDV: 0,00" />
                <Label fx:id="lblGrossTotal" text="Genel toplam: 0,00" />
            </children>
        </HBox>
    </children>
</AnchorPane>
