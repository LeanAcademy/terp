<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="920.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.terp.uretim.gui.ProductionOrderEditFormController">
    <stylesheets>
        <URL value="@../styles/recipeform.css" />
    </stylesheets>
    <children>
        <ToolBar prefHeight="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <Button fx:id="btnSave" mnemonicParsing="false" onAction="#onActionBtnSave" text="Taslak kaydet" />
                <Button fx:id="btnApprove" defaultButton="true" mnemonicParsing="false" onAction="#onActionBtnApprove" text="Onayla" />
                <Button fx:id="btnExplode" mnemonicParsing="false" onAction="#onActionBtnExplode" text="Reçeteyi patlat" />
                <Button fx:id="btnCancelPosted" mnemonicParsing="false" onAction="#onActionBtnCancelPosted" text="İptal" />
                <Button fx:id="btnClose" cancelButton="true" mnemonicParsing="false" onAction="#onActionBtnClose" text="Kapat" />
            </items>
        </ToolBar>
        <GridPane hgap="10.0" vgap="8.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="48.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints prefWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Belge no" />
                <TextField fx:id="txtDocumentNo" promptText="Boş = otomatik" GridPane.columnIndex="1" />
                <Label text="Tarih" GridPane.columnIndex="2" />
                <DatePicker fx:id="dtDocumentDate" maxWidth="Infinity" GridPane.columnIndex="3" />
                <Label text="Mamul" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbProduct" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Depo" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbWarehouse" editable="true" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <Label text="Miktar" GridPane.rowIndex="2" />
                <TextField alignment="CENTER_RIGHT" fx:id="txtPlannedQty" promptText="Plan" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Üretilen" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <TextField alignment="CENTER_RIGHT" fx:id="txtCompletedQty" disable="true" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                <Label text="Sipariş" GridPane.rowIndex="3" />
                <TextField fx:id="txtSourceOrderNo" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Birim" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                <TextField fx:id="txtProductUnit" disable="true" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                <Label text="Notlar" GridPane.rowIndex="4" />
                <TextArea fx:id="txtNotes" prefHeight="44.0" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4" />
            </children>
        </GridPane>
        <HBox spacing="8.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="268.0">
            <children>
                <ComboBox fx:id="cmbItem" editable="true" maxWidth="Infinity" prefWidth="300.0" promptText="Malzeme" />
                <TextField alignment="CENTER_RIGHT" fx:id="txtQuantity" prefWidth="90.0" promptText="Sarf" />
                <TextField fx:id="txtUnit" prefWidth="70.0" promptText="Birim" />
                <Button fx:id="btnAddLine" mnemonicParsing="false" onAction="#onActionBtnAddLine" text="Satır ekle" />
                <Button fx:id="btnRemoveLine" mnemonicParsing="false" onAction="#onActionBtnRemoveLine" text="Satır sil" />
            </children>
        </HBox>
        <TableView fx:id="tblvLines" tableMenuButtonVisible="true" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="308.0">
            <columns>
                <TableColumn fx:id="tcItemCode" prefWidth="110.0" text="Kod" />
                <TableColumn fx:id="tcItemDesc" prefWidth="280.0" text="Malzeme" />
                <TableColumn fx:id="tcItemUnit" prefWidth="70.0" text="Birim" />
                <TableColumn fx:id="tcPlannedQty" prefWidth="90.0" text="Sarf" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
