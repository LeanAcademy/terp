<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560.0" prefWidth="860.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.terp.uretim.gui.ProductionCompletionFormController">
    <stylesheets>
        <URL value="@../styles/recipeform.css" />
    </stylesheets>
    <top>
        <VBox>
            <children>
                <ToolBar prefHeight="40.0">
                    <items>
                        <Button fx:id="btnApprove" defaultButton="true" mnemonicParsing="false" onAction="#onActionBtnApprove" text="Onayla" />
                        <Button fx:id="btnClose" cancelButton="true" mnemonicParsing="false" onAction="#onActionBtnClose" text="Kapat" />
                    </items>
                </ToolBar>
                <GridPane hgap="10.0" vgap="8.0">
                    <padding>
                        <Insets bottom="8.0" left="16.0" right="16.0" top="12.0" />
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints prefWidth="110.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints prefWidth="90.0" />
                        <ColumnConstraints prefWidth="140.0" />
                    </columnConstraints>
                    <children>
                        <Label text="Üretim emri" />
                        <ComboBox fx:id="cmbOrder" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" />
                        <Label text="Kalan" GridPane.columnIndex="2" />
                        <TextField alignment="CENTER_RIGHT" fx:id="txtRemaining" disable="true" GridPane.columnIndex="3" />
                        <Label text="Tarih" GridPane.rowIndex="1" />
                        <DatePicker fx:id="dtDocumentDate" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Üretilen" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField alignment="CENTER_RIGHT" fx:id="txtProducedQty" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <Label text="Lot / seri" GridPane.rowIndex="2" />
                        <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2">
                            <children>
                                <TextField fx:id="txtLotNo" maxWidth="Infinity" HBox.hgrow="ALWAYS" promptText="Mamul lot" />
                                <TextField fx:id="txtSerialNo" maxWidth="Infinity" HBox.hgrow="ALWAYS" promptText="Seri" />
                                <DatePicker fx:id="dtExpiry" prefWidth="160.0" promptText="SKT" />
                            </children>
                        </HBox>
                    </children>
                </GridPane>
                <Label text="Bu iş bitişinde sarf edilecek malzemeler (düzenlenebilir)">
                    <padding>
                        <Insets bottom="6.0" left="16.0" right="16.0" />
                    </padding>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tblvLines" editable="true">
            <BorderPane.margin>
                <Insets bottom="12.0" left="16.0" right="16.0" />
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="tcItemCode" editable="false" prefWidth="110.0" text="Kod" />
                <TableColumn fx:id="tcItemDesc" editable="false" prefWidth="280.0" text="Malzeme" />
                <TableColumn fx:id="tcItemUnit" editable="false" prefWidth="70.0" text="Birim" />
                <TableColumn fx:id="tcQuantity" prefWidth="90.0" text="Sarf" />
                <TableColumn fx:id="tcLotNo" prefWidth="90.0" text="Lot" />
                <TableColumn fx:id="tcSerialNo" prefWidth="90.0" text="Seri" />
            </columns>
        </TableView>
    </center>
</BorderPane>
